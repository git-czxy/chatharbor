# Copy to .env and set the bind address to a trusted NAS LAN address if remote browser access is needed.
# Keep .env private; never commit actual host paths, credentials, or LAN addresses.
CHATHARBOR_ARCHIVE_HOST_PATH=/path/on/nas/ConversationStore/chatgpt
CHATHARBOR_BIND_ADDRESS=127.0.0.1
CHATHARBOR_WEB_PORT=5808
CHATHARBOR_UID=1000
CHATHARBOR_GID=1001
TZ=Asia/Shanghai
